PORT=3005
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret

# Create an app at https://developer.yahoo.com/apps/ and enable Fantasy Sports.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=http://localhost:3005/api/yahoo/callback
FRONTEND_URL=http://localhost:5173

# External NBA data provider (Tank01 via RapidAPI). Powers Fantasy Basketball
# projections, Start/Sit, waivers, and trade valuation. Server-side only.
RAPIDAPI_KEY=

# stats.nba.com fallback (no key). Off by default (blocks datacenter IPs in prod).
NBA_STATS_FALLBACK=false

# Optional: Ask ProGM (Gemini) explanation layer. Without it, chat is disabled.
GEMINI_API_KEY=
